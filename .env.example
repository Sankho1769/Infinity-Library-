# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=infinity_library
DB_USERNAME=library_admin
DB_PASSWORD=change_this_to_a_secure_password_in_production

# JWT Security
# 256-bit (32-byte) or longer secret key encoded in Base64 or plain text (min 32 chars)
JWT_SECRET=super_secret_jwt_signing_key_for_infinity_library_must_be_at_least_256_bits_long_2026
JWT_EXPIRATION_MS=900000
# 15 minutes = 900,000 ms
JWT_REFRESH_EXPIRATION_MS=604800000
# 7 days = 604,800,000 ms

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
